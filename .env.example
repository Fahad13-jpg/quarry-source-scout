# Copy to .env; never commit credentials.
DATABASE_URL=sqlite:///data/scout.sqlite
LOG_LEVEL=INFO
REDDIT_ACCESS_APPROVED=false
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=QuarrySourceScout/0.1 by your_reddit_username
# Existing client adapters; leave empty for unknown-only validation / no forwarding.
VALIDATION_ENABLED=false
VALIDATOR_ENDPOINT=
VALIDATOR_TOKEN=
EXISTING_PIPELINE_ENDPOINT=
EXISTING_PIPELINE_TOKEN=
